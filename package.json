{
  "name": "@aslaluroba/help-center",
  "version": "3.0.4",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "packagr": "ng-packagr -p ng-package.json",
    "build:lib": "yarn clean && yarn packagr",
    "clean": "rimraf dist",
    "prepublishOnly": "yarn build:lib",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "publish:patch": "yarn clean && yarn version:patch && yarn build:lib && cd dist/help-center && yarn publish --no-git-tag-version",
    "publish:minor": "yarn clean && yarn version:minor && yarn build:lib && cd dist/help-center && yarn publish --no-git-tag-version",
    "publish:major": "yarn clean && yarn version:major && yarn build:lib && cd dist/help-center && yarn publish --no-git-tag-version"
  },
  "private": false,
  "license": "MIT",
  "peerDependencies": {
    "@angular/common": ">=19.0.0",
    "@angular/core": ">=19.0.0",
    "@angular/forms": ">=19.0.0",
    "@angular/platform-browser": ">=19.0.0",
    "@angular/router": ">=19.0.0",
    "rxjs": ">=7.0.0",
    "zone.js": ">=0.15.0"
  },
  "dependencies": {
    "ably": "^2.9.0",
    "clsx": "^2.1.1",
    "marked": "^16.3.0",
    "prismjs": "^1.29.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular-devkit/build-angular": "^20.3.1",
    "@angular/cli": "^20.3.1",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "rimraf": "^6.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "zone.js": "~0.15.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/aslaluroba/help-center"
  },
  "keywords": [
    "angular",
    "help-center",
    "widget",
    "chat",
    "support",
    "ai-assistant",
    "real-time"
  ],
  "author": "AslaLuroba",
  "bugs": {
    "url": "https://github.com/aslaluroba/help-center/issues"
  },
  "homepage": "https://github.com/aslaluroba/help-center#readme",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
